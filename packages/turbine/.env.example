# NusterKit Turbine — Environment Variables
# Copy this file to .env and fill in the values.

# === Required in production (Balena provides these) ===

# Prisma database connection string
DATABASE_URL=file:/data/database.db

# Balena Supervisor API
BALENA_SUPERVISOR_ADDRESS=http://localhost:48484
BALENA_SUPERVISOR_API_KEY=
BALENA_APP_ID=

# === Development only ===

# Simulation server HTTP URL (portless domain)
SIMULATION_URL=https://sim-server.nuster.localhost

# Simulation server Modbus TCP IP (for IO handler connections)
SIMULATION_ADDRESS=127.0.0.1
