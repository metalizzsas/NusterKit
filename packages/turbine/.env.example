# NusterKit Turbine — Environment Variables
# Copy this file to .env and fill in the values.

# === Always required ===

# HTTP server port (default: 4080)
PORT=4080

# === Required in production (Balena provides these) ===

# Prisma database connection string
DATABASE_URL=file:/data/database.db

# Balena Supervisor API
BALENA_SUPERVISOR_ADDRESS=http://localhost:48484
BALENA_SUPERVISOR_API_KEY=
BALENA_APP_ID=

# === Optional (development only) ===

# Simulation server address (for dev mode with simulation-server)
SIMULATION_ADDRESS=localhost
SIMULATION_PORT=4082
