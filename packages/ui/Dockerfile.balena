# Variante balena local-mode du Dockerfile UI.
#
# Identique à packages/ui/Dockerfile SAUF les `RUN --mount=type=cache` (BuildKit),
# que le builder balena en local mode ne gère pas → remplacés par des `pnpm install`
# simples. Garder en phase avec l'amont si celui-ci change.

FROM node:24-alpine@sha256:8510330d3eb72c804231a834b1a8ebb55cb3796c3e4431297a24d246b8add4d5 AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json .
COPY pnpm-lock.yaml .

FROM base AS prod-deps
RUN pnpm install --prod

# Builder image step
FROM base AS build

COPY svelte.config.js .
COPY vite.config.ts .
COPY tsconfig.json .
COPY static/ ./static
COPY src/ ./src

RUN pnpm install
RUN pnpm build

# Production final image
FROM base AS production

ENV NODE_ENV=production
ENV PORT=4081
EXPOSE 4081

COPY --from=prod-deps /app/node_modules /app/node_modules
COPY --from=build /app/build /app/build

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
# chown sans node_modules (énorme -> très lent sur la VM ARM). Il reste root mais
# lisible par nodejs, ce qui suffit au runtime.
RUN chown nodejs:nodejs /app && \
    for e in /app/*; do \
      [ "$e" = /app/node_modules ] || chown -R nodejs:nodejs "$e"; \
    done
USER nodejs

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:4081/ || exit 1

CMD [ "node", "build" ]
