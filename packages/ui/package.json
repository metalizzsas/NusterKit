{
	"name": "@nuster/ui",
	"version": "2.4.0-beta.10",
	"private": true,
	"description": "User interface for Turbine",
	"main": "build/index.js",
	"license": "UNLICENSED",
	"author": "@metalizzsas/kworz",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"check": "svelte-check",
		"sync": "svelte-kit sync",
		"dev": "portless ui.nuster vite dev",
		"build": "pnpm run openapi:generate && svelte-kit sync && vite build",
		"start": "node build",
		"preview": "vite preview --port 4081",
		"test": "svelte-check --tsconfig ./tsconfig.json",
		"test:a11y": "playwright test",
		"lint": "biome check src/",
		"openapi:generate": "openapi-typescript ../turbine/openapi.json -o src/lib/api/openapi.d.ts",
		"openapi": "pnpm --filter @nuster/turbine run openapi:extract && pnpm run openapi:generate"
	},
	"dependencies": {
		"@fontsource/inter": "^5.1.0",
		"@humanspeak/svelte-markdown": "^1.4.0",
		"@steeze-ui/heroicons": "^2.4.0",
		"@steeze-ui/svelte-icon": "^1.6.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"cookie": "^1.0.0",
		"openapi-fetch": "^0.17.0",
		"simple-keyboard": "^3.8.0",
		"simple-keyboard-input-mask": "^3.0.526",
		"simple-keyboard-layouts": "^3.4.0",
		"svelte-i18n": "^4.0.0",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.16.0",
		"@tailwindcss/vite": "^4.2.0",
		"@types/cookie": "^0.6.0",
		"@types/node": "^24.0.0",
		"axe-core": "^4.12.0",
		"dotenv": "^16.4.5",
		"mode-watcher": "^1.1.0",
		"npm-run-all": "^4.1.5",
		"openapi-typescript": "^7.13.0",
		"sass": "^1.99.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-portal": "^2.2.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.0",
		"typescript": "^5.9.0",
		"vite": "^6.0.0"
	}
}
